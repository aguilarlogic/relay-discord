# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Model used to write answers. Defaults to claude-opus-5; claude-sonnet-5 is
# cheaper per answer if you are running at high volume.
RELAY_MODEL=claude-opus-5
# Cheaper model used for the daily digest's topic clustering.
RELAY_FAST_MODEL=claude-haiku-4-5

# SQLite database path (gitignored data/ dir by default)
DATABASE_PATH=data/relay.db

# Premium App subscription SKU id (Developer Portal -> Monetization -> SKUs).
# Leave empty to run with no plan limits (self-hosting / development).
PREMIUM_SKU_ID=

# Optional: sync slash commands instantly to this one guild while developing.
DEV_GUILD_ID=
