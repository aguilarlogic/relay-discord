# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Anthropic API key (console.anthropic.com). Pays for the paid tiers' answers.
ANTHROPIC_API_KEY=

# --- Free tier AI ----------------------------------------------------------
# Any OpenAI-compatible chat API. Default: Google Gemini's free API.
# Get a key at https://aistudio.google.com/apikey and pick a model that is on
# the free tier there (a current "flash" or "flash-lite" model id).
FREE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FREE_LLM_API_KEY=
FREE_LLM_MODEL=
# json_schema (strict structured output), json_object (JSON mode), or none.
# Switch to json_object if your provider rejects json_schema.
FREE_LLM_JSON_MODE=json_schema
# Groq instead: FREE_LLM_BASE_URL=https://api.groq.com/openai/v1 with a Groq
# key and model id, and FREE_LLM_JSON_MODE=json_object.

# --- Plans -----------------------------------------------------------------
# Tiers, prices, limits, top-up packs, and each tier's model live here.
RELAY_TIERS_PATH=tiers.toml
# Model for the daily digest's topic grouping (paid tiers only).
RELAY_FAST_MODEL=claude-haiku-4-5

# SQLite database path (gitignored data/ dir by default)
DATABASE_PATH=data/relay.db

# Optional: sync slash commands instantly to this one guild while developing.
DEV_GUILD_ID=
